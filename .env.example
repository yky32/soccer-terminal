# API-Football (https://www.api-football.com/) — only needed when FOOTBALL_DATA_PROVIDER=api-football
# API_FOOTBALL_KEY=your_key_here
#
# Production:
# - API key is server-only (Next.js API routes / RSC). Never expose in NEXT_PUBLIC_* or client fetch.
# - Cache tiers live in src/lib/football/refresh-policy.ts (live 60s, standings 10m, players 24h).
# - Monitor daily quota: https://dashboard.api-football.com/

# Data provider: mock (offline dev) | api-football (live API)
# Match detail pages (/matches/*) always require API_FOOTBALL_KEY — no mock fallback.
FOOTBALL_DATA_PROVIDER=api-football

# Log request/response DTOs for every API call (default: on)
# API_HTTP_LOG=false

# OpenAI-compatible LLM for AI briefing + chat (optional — demo mode when unset)
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Feature flags
# Default is disabled. Set to true to show.
# NEXT_PUBLIC_ENABLE_NEWS=true
# NEXT_PUBLIC_ENABLE_AI=true
